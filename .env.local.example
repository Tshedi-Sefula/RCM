# Copy this file to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API.
# .env.local is git-ignored; never commit real keys.

# Public: safe to expose to the browser.
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / publishable key. Safe in the browser because RLS limits it to reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_
# and never commit the real value. Required for /threads/[ticket_id], where
# contact form senders read and reply to their conversation
# (lib/data/threads.ts via lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: the public address of the site, without a trailing slash, used
# for canonical URLs, Open Graph tags, robots.txt and sitemap.xml.
# On Vercel it defaults to the project's production domain, so you only
# need this once you add a custom domain, e.g. https://www.rcmtoitskraal.co.za
NEXT_PUBLIC_SITE_URL=
