# Copy this file to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API.
# .env.local is git-ignored; never commit real keys.

# Public: safe to expose to the browser.
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / publishable key. Safe in the browser because RLS limits it to reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_
# and never commit the real value. Only needed for trusted admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
